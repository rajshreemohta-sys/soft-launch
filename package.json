{
  "name": "soft-launch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "news:coverage": "node scripts/news-coverage.mts",
    "collect": "tsx --conditions=react-server --env-file=.env.local scripts/collect.mts",
    "test": "tsx --test tests/*.test.ts",
    "test:protection": "tsx --conditions=react-server --env-file=.env.local scripts/test-protection.mts",
    "rescore": "tsx --conditions=react-server --env-file=.env.local scripts/rescore.mts",
    "hotlist": "tsx --conditions=react-server --env-file=.env.local scripts/hotlist.mts",
    "e2e:dry": "tsx --conditions=react-server --env-file=.env.local scripts/e2e-dry.mts",
    "enrich": "tsx --conditions=react-server --env-file=.env.local scripts/enrich.mts"
  },
  "dependencies": {
    "@google/genai": "^2.28.0",
    "@supabase/supabase-js": "^2.117.3",
    "fast-xml-parser": "^5.11.2",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.32.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
