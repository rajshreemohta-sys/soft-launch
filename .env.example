# Copy to .env.local for local runs, and add the same names in Vercel → Settings → Environment Variables.
# Never commit real values.

# Supabase (Project settings → API keys). The service role key is server-only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gemini (Google AI Studio). gemini-2.5-flash is closed to new keys, so this project uses gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Resend. On the free plan with the test sender, HOTLIST_TO_EMAIL must be your Resend account email.
RESEND_API_KEY=
HOTLIST_TO_EMAIL=
# Optional: a sender on a verified domain (default: ShiftSense <onboarding@resend.dev>)
HOTLIST_FROM_EMAIL=

# Random string; Vercel Cron sends it as a Bearer token. Generate with: openssl rand -hex 32
CRON_SECRET=

# Hot List eligibility window in days, and dry-run mode (true = build and save the email, never send)
HOT_LIST_WINDOW_DAYS=3
DRY_RUN=false

# Optional: base URL for links in the email (default: Vercel's production URL)
APP_URL=

# Outreach Send button: passcode (only this action is protected), approved test recipients
# (comma-separated; default HOTLIST_TO_EMAIL), optional sender and reply-to.
SEND_PASSCODE=
OUTREACH_TEST_RECIPIENTS=
OUTREACH_FROM_EMAIL=
OUTREACH_REPLY_TO=
